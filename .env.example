# BotFather 创建 Bot 后获得的 Token（必填）
BOT_TOKEN=

# SQLite 元数据库路径（默认 files.db，只存 file_id 等元数据，不含文件本体）
DB_PATH=files.db

# 允许使用本 Bot 的用户 ID（逗号分隔，多个用英文逗号）。
# 留空 = 允许所有人（个人助手建议务必填写，用 @userinfobot 查询自己的 ID）
ALLOWED_USER_IDS=

# 展示时间用的时区（默认 Asia/Shanghai）
TIMEZONE=Asia/Shanghai

# 网络配置（解决 ConnectError / 网络不稳定）
# 可选代理：http://127.0.0.1:7890 或 socks5://127.0.0.1:1080
# 留空 = 使用系统环境变量 HTTP_PROXY/HTTPS_PROXY（若有）
PROXY_URL=

# httpx 超时（秒），网络差时调大
CONNECT_TIMEOUT=15
READ_TIMEOUT=30
WRITE_TIMEOUT=30
POOL_TIMEOUT=15
